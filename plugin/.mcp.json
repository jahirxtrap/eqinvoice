{
  "mcpServers": {
    "eqinvoice": {
      "command": "uvx",
      "args": ["--from", "eqinvoice[mcp]==1.1.1", "eqinvoice-mcp"],
      "env": {
        "EQINVOICE_BOOK": "${user_config.book}",
        "EQINVOICE_P12": "${user_config.signature}",
        "EQINVOICE_P12_PASSWORD": "${user_config.signature_password}"
      }
    }
  }
}